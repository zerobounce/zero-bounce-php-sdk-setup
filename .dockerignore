.git
.gitignore

# Docs not needed to run tests in the image (CHANGELOG.md is: a test reads it)
*.md
documentation*.md
!CHANGELOG.md

# Local Composer install (image runs composer install)
vendor/

# PHPUnit / tooling
.phpunit.cache/
phpunit.result.cache
coverage/

# OS & env
.DS_Store
Thumbs.db
.env
.env.*
