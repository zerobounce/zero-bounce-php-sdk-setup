{
  "name": "zero-bounce/sdk",
  "version": "3.0.0",
  "description": "Official ZeroBounce PHP SDK: email validation, AI scoring, bulk files, email finder and domain search",
  "keywords": [
    "zerobounce",
    "email-validation",
    "email-verification",
    "email-finder",
    "domain-search",
    "sdk"
  ],
  "homepage": "https://www.zerobounce.net",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/zerobounce/zero-bounce-php-sdk-setup/issues",
    "source": "https://github.com/zerobounce/zero-bounce-php-sdk-setup",
    "docs": "https://www.zerobounce.net/docs/"
  },
  "scripts": {
    "dumpautoload": "composer dumpautoload -o",
    "lint": "find src test live -name '*.php' -exec php -l {} \\;",
    "test": "phpunit --colors=always",
    "test:live": "php live/live_api.php"
  },
  "authors": [
    {
      "name": "Zero Bounce",
      "email": "integrations@zerobounce.net",
      "homepage": "https://www.zerobounce.net/"
    }
  ],
  "type": "library",
  "require": {
    "php": ">=7.0",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5.63"
  },
  "autoload": {
    "psr-4": {
      "ZeroBounce\\SDK\\": "src/"
    }
  }
}
